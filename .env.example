MONGO_URI=mongodb://localhost:27017
DB_NAME=your_db_name
JWT_SECRET=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COLLEGE_EMAIL_DOMAIN=msrit.edu
ALLOWED_ORIGINS=http://localhost:3000
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sdg-attachments
ADMIN_EMAIL=admin@msrit.edu
ADMIN_PASSWORD=your_admin_password
ADMIN_COLLEGE_ID=your_admin_id
# Google OAuth (obtain from Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback
FRONTEND_URL=http://localhost
# SMTP email OTP verification. Gmail requires an app password; use college SMTP
# credentials in production. Keep actual values only in the untracked .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender_email@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_sender_email@example.com
SMTP_USE_TLS=true
